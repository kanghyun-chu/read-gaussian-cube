function plotIso( Cubes, isolevels , figN )
% Visualization of Isosurfaces for Gaussian-cube struct object
%   Example)
%      plotIso( Cube, [-0.01, 0.01] )
%         This will create a two isosurfaces of level ±0.01 in a new figure.
%
%      plotIso( Cubes(1:8), [0.01, 0.1, 1], 100) 
%         Cubes must be a struct array at least 8 elements in it.
%         This will create 8 figures from figure(100) to figure(107) with
%         three isosurfaces of level 0.01, 0.1, and 1.

arguments
    Cubes     struct
    isolevels double
    figN      double=0
end

iso_clr = cool(numel(isolevels)); 

rad_rgb = load_Colorcode();

for N = 1:numel(Cubes)
    
    Cube = Cubes(N);

    if figN == 0 | mod(figN,1)~=0 % figN=0 or invalid value
       figure;                    % Create new figure
    else
       figure(N+(figN-1));        % Update figures from index figN
       clf;
    end
    hold on
    
    if isequal( size(Cube.resolution), [1,3])
        % Orthogonal Axes
        % Define Grid system. Array index ordering is ZYX
        [Z,Y,X] = ndgrid( Cube.axis_3 , Cube.axis_2 , Cube.axis_1);
    
    else
        % Non-orthogonal crystal axes
        U = size( Cube.axis_1,2 ); % Axis_1 step
        V = size( Cube.axis_2,2 ); %            
        W = size( Cube.axis_3,2 ); %            
        
        [w,v,u] = ndgrid(0:W-1,0:V-1,0:U-1);
        
        X = Cube.resolution(1,1)*u + Cube.resolution(2,1)*v + Cube.resolution(3,1)*w;
        Y = Cube.resolution(1,2)*u + Cube.resolution(2,2)*v + Cube.resolution(3,2)*w;
        Z = Cube.resolution(1,3)*u + Cube.resolution(2,3)*v + Cube.resolution(3,3)*w;
      
      % Origin at axis_1(:,1)
        X = X + Cube.axis_1(1,1);
        Y = Y + Cube.axis_1(2,1);
        Z = Z + Cube.axis_1(3,1);
        clear w v u
    end
    %% Draw Boundary Box 
    bbox = [X(1,1,1),X(end,1,1),X(end,end,1),X(1,end,1),X(1,1,1),nan,X(1,1,end),X(end,1,end),X(end,end,end),X(1,end,end),X(1,1,end),nan,X(1,1,1),X(1,1,end),nan,X(1,end,1),X(1,end,end),nan,X(end,end,1),X(end,end,end),nan,X(end,1,1),X(end,1,end); ...
            Y(1,1,1),Y(end,1,1),Y(end,end,1),Y(1,end,1),Y(1,1,1),nan,Y(1,1,end),Y(end,1,end),Y(end,end,end),Y(1,end,end),Y(1,1,end),nan,Y(1,1,1),Y(1,1,end),nan,Y(1,end,1),Y(1,end,end),nan,Y(end,end,1),Y(end,end,end),nan,Y(end,1,1),Y(end,1,end); ...
            Z(1,1,1),Z(end,1,1),Z(end,end,1),Z(1,end,1),Z(1,1,1),nan,Z(1,1,end),Z(end,1,end),Z(end,end,end),Z(1,end,end),Z(1,1,end),nan,Z(1,1,1),Z(1,1,end),nan,Z(1,end,1),Z(1,end,end),nan,Z(end,end,1),Z(end,end,end),nan,Z(end,1,1),Z(end,1,end) ];
    line( bbox(1,:), bbox(2,:), bbox(3,:),'Color',[0.5 0.5 0.5],'LineWidth',1 )

    %% Visualize Configuration
    Atom = Cube.config{:,1}; % Must be Integers
    Atom(Atom>=96) = 96;

    scatter3( Cube.config{:,3}, Cube.config{:,4}, Cube.config{:,5}, ...
        rad_rgb(Atom,1).^2 *100, ... % Atom sizes
        rad_rgb(Atom,2:4), ... % Atom coloring
        'filled')
    grid on
    xlabel('X');
    ylabel('Y');
    zlabel('Z');
    title({Cube.title, Cube.subtitle})
    %% Show Isosurface
    data = Cube.cubedat;
   
    for n = 1:numel(isolevels)
        iso = isolevels(n);
        
        p = isosurface( permute(X,[2,3,1]), ... % z,y,x-order to y,x,z-order for Matlab's isosurface function
                        permute(Y,[2,3,1]), ...
                        permute(Z,[2,3,1]), ...
                        permute(data,[2,3,1]), iso); 

        patch('Faces',p.faces,'Vertices',p.vertices, ...
            'FaceAlpha',0.5 ,...
            'EdgeColor','none',...
            'FaceColor',iso_clr(n,:))
    end

    axis equal tight
    view(3);
end
end

